---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import CTASection from '../../components/CTASection.astro';
import { divisions } from '../../data/divisions';
import { ld, siteUrl } from '../../utils/seo';

export function getStaticPaths() {
  return divisions.map((d) => ({ params: { division: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;
const path = `/projects/${d.slug}/`;
const title = `${d.title} | M.M. Knitwear Ltd.`;
const description = `${d.short} ${d.text}`.slice(0, 158);
const keywords =
  'knitwear production division bangladesh, garment factory gazipur, knit composite factory divisions';

const jsonLd = [
  ld({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: siteUrl + '/projects/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: siteUrl + path },
    ],
  }),
  ld({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: d.title,
    url: siteUrl + path,
    description: d.short,
    inLanguage: 'en',
  }),
];
---

<BaseLayout title={title} description={description} keywords={keywords} canonical={path} jsonLd={jsonLd} active="projects">
  <PageHeader eyebrow="Production Divisions" title={d.title} crumb="Projects" crumbHref="/projects/" intro={d.short} />

  <section class="section">
    <div class="container">
      <div class="division-page">
        <div class="division-page__media reveal">
          <img src={u(d.img)} alt={d.title} width="1200" height="800" loading="lazy" />
        </div>
        <div class="division-page__body reveal">
          <div class="division-page__stat">
            <span class="eyebrow">Capacity &amp; Scale</span>
            <strong>{d.stat}</strong>
          </div>
          <h2>{d.title}</h2>
          <p>{d.text}</p>
          <a class="btn btn--primary" href={u('projects/')}>
            View All Divisions
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle
        eyebrow="Key Information"
        title="Facility at a Glance"
        text="The key figures and capabilities that define this division."
        center
      />
      <div class="division-facts">
        {d.facts.map((f) => (
          <div class="division-fact reveal">
            <span>{f.label}</span>
            <strong>{f.value}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="division-overview">
        <div class="division-overview__intro reveal">
          <span class="eyebrow">Overview</span>
          <h2>About this Division</h2>
          <p>{d.overview}</p>
        </div>
        <div class="division-overview__checks">
          <ul class="split__checks">
            {d.highlights.map((h) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {h}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .division-page {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .division-page__media {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 2;
    box-shadow: var(--shadow);
  }

  .division-page__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .division-page__stat {
    background: linear-gradient(135deg, var(--brand-800), var(--brand));
    color: #fff;
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    margin-bottom: 1.6rem;
  }

  .division-page__stat .eyebrow {
    color: #d5f2ff;
    margin-bottom: 0.4rem;
  }

  .division-page__stat strong {
    display: block;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1.25;
  }

  .division-page__body h2 {
    margin-bottom: 0.9rem;
  }

  .division-page__body p {
    font-size: 1.0625rem;
    margin-bottom: 1.6rem;
  }

  .division-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .division-fact {
    background: #fff;
    border: 1.5px solid var(--brand-600);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 24px -12px rgba(0, 163, 222, 0.45);
    padding: 1.4rem 1.2rem;
    text-align: center;
    display: grid;
    gap: 0.4rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .division-fact:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -16px rgba(0, 163, 222, 0.55);
  }

  .division-fact span {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .division-fact strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--brand-800);
  }

  .division-overview {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .division-overview__intro h2 {
    margin: 0.75rem 0 1.1rem;
  }

  .division-overview__checks {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
  }

  .division-overview__checks .split__checks {
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .division-facts { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .division-page,
    .division-overview { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .division-facts { grid-template-columns: 1fr; }
  }
</style>
