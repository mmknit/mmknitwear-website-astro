---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="video-wrap">
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
