---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CTASection from '../components/CTASection.astro';
import DivisionSubnav from '../components/DivisionSubnav.astro';
import { divisions } from '../data/divisions';
import { ld, breadcrumb, siteUrl } from '../utils/seo';

const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;

const title = 'Our Production Divisions | M.M. Knitwear Ltd.';
const description =
  'Explore the in-house production divisions of M.M. Knitwear Ltd. — garments, knitting, dyeing, cutting, printing, embroidery, AOP and laundry facilities in Gazipur, Bangladesh.';
const keywords =
  'garments manufacturing divisions bangladesh, knitting dyeing printing embroidery factory, garment production capacity, aop printing factory bangladesh';

const projectsPage = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Production Divisions',
  url: siteUrl + '/projects/',
  description: 'In-house production divisions of M.M. Knitwear Ltd.',
  numberOfItems: divisions.length,
  itemListElement: divisions.map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: d.title,
    image: siteUrl + '/upload/' + d.img.split('/').pop(),
  })),
  inLanguage: 'en',
};

const jsonLd = [ld(breadcrumb('Projects', '/projects/')), ld(projectsPage)];
---

<BaseLayout title={title} description={description} keywords={keywords} canonical="/projects/" jsonLd={jsonLd} active="projects">
  <PageHeader eyebrow="Capabilities" title="Our Projects" crumb="Projects"
    intro="Every stage of production is managed in-house across our vertically integrated knit composite factory in Gazipur — from knitting and dyeing to sewing, printing and finishing." />
  <DivisionSubnav />

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Production Divisions"
        title="A Complete Vertical Operation"
        text="Our facilities work as one integrated production line, keeping quality, lead time and compliance fully under our control."
      />
      <div class="divisions">
        {divisions.map((d) => (
          <article class="card division-card reveal">
            <div class="division-card__media">
              <img src={u(d.img)} alt={d.title} loading="lazy" width="600" height="400" />
            </div>
            <div class="division-card__body">
              <h3>{d.title}</h3>
              <p>{d.text}</p>
              <div class="division-card__stat">{d.stat}</div>
              <a class="btn btn--primary btn--sm division-card__link" href={u(`projects/${d.slug}/`)}>
                Learn More
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .divisions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .divisions { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .divisions { grid-template-columns: 1fr; }
  }

  .division-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .division-card__media {
    aspect-ratio: 3/2;
    overflow: hidden;
  }

  .division-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .division-card:hover .division-card__media img {
    transform: scale(1.06);
  }

  .division-card__body {
    padding: 1.6rem 1.6rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .division-card__body h3 {
    font-size: 1.12rem;
    margin-bottom: 0;
  }

  .division-card__body p {
    font-size: 0.93rem;
  }

  .division-card__stat {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--brand-800);
  }

  .division-card__link {
    align-self: flex-start;
  }
</style>
