---
interface Props {
  shareUrl: string;
  shareTitle: string;
}

const { shareUrl, shareTitle } = Astro.props;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(shareTitle);
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const li = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const tw = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
---

        <footer>
            <div class="kleanity-footer-wrapper">
                <div class="kleanity-footer-container kleanity-container clearfix">
                    <div class="kleanity-footer-column kleanity-item-pdlr kleanity-column-15">
                        <div id="text-3" class="widget widget_text kleanity-widget">
                            <div class="textwidget"><span class="gdlr-core-space-shortcode" style="margin-top: -2px;"></span> <img src="/upload/footer-logo.png" alt="M.M. Knitwear Ltd. logo"  loading="lazy"/> <span class="gdlr-core-space-shortcode" style="margin-top: 25px;"></span> <b>Head Office:</b> House-16, Road-10, Sector-01, Uttara Model Town, Dhaka, Bangladesh <br> <br> <b>Factory:</b> Ambagh Road, Nilnagar, Konabari, Gazipur, Bangladesh.</div>
                        </div>
                    </div>
                    <div class="kleanity-footer-column kleanity-item-pdlr kleanity-column-15">
                        <div id="recent-posts-3" class="widget widget_recent_entries kleanity-widget">
                            <h3 class="kleanity-widget-title"><span class="kleanity-widget-head-text">Our Sister Companies</span><span class="kleanity-widget-head-divider"></span></h3><span class="clear"></span>
