---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  center?: boolean;
}

const { eyebrow, title, text, center } = Astro.props;
---

<div class={`section-head${center ? ' section-head--center' : ''}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {text && <p>{text}</p>}
</div>
