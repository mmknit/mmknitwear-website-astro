dlr-core-item-pdb gdlr-core-divider-item-normal\" style=\"padding-bottom: 10px;\">\n                                                    <div class=\"gdlr-core-divider-line gdlr-core-skin-divider\" style=\"border-bottom-width: 2px;\"></div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 15px;\">\n                                                        <p>01</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-15\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 0px 0px 30px 0px;\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js \">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-column-service-item gdlr-core-item-pdb  gdlr-core-left-align gdlr-core-column-service-icon-top gdlr-core-no-caption gdlr-core-item-pdlr\" style=\"padding-bottom: 15px;\">\n                                                    <div class=\"gdlr-core-column-service-media gdlr-core-media-image\"><img src=\"/upload/service-icon-2.png\" alt=\"Fabric Sourcing icon\" width=\"50\" height=\"50\"  loading=\"lazy\"></div>\n                 