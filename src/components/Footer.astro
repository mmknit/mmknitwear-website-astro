---
import { SITE, socials } from '../data/site';

const base = import.meta.env.BASE_URL;

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Compliance', href: '/compliance/' },
  { label: 'Projects', href: '/projects/' },
];

const moreLinks = [
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Knitting Division', href: '/out-projects/' },
  { label: 'Contact Us', href: '/contact/' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href={base} aria-label="M.M. Knitwear Ltd. — Home">
          <img src={base + 'upload/footer-logo.png'} alt="M.M. Knitwear Ltd." width="176" height="46" />
        </a>
        <p>
          100% export-oriented knit composite manufacturer producing high-quality knitted
          apparel for leading international brands since 2001.
        </p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3>Company</h3>
        <ul role="list">
          {quickLinks.map((l) => (
            <li><a href={base + l.href.slice(1)}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Explore</h3>
        <ul role="list">
          {moreLinks.map((l) => (
            <li><a href={base + l.href.slice(1)}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Contact</h3>
        <ul class="site-footer__contact" role="list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>{SITE.headOffice}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2Z" />
            </svg>
            <span>
              {SITE.phoneHead}
              <br />
              {SITE.phoneFactory}
            </span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__bottom-inner">
        <span>&copy; {year} {SITE.name}. All rights reserved.</span>
        <a href="http://www.mamunknitwear.com" target="_blank" rel="noreferrer">
          A Mamun Knitwear Group Company
        </a>
      </div>
    </div>
  </div>
</footer>
