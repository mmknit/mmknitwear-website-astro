---
import { divisions } from '../data/divisions';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="division-subnav" aria-label="Production divisions">
  <div class="container">
    <span class="division-subnav__label">Divisions</span>
    <div class="division-subnav__links">
      {divisions.map((d) => (
        <a
          href={`${base}projects/${d.slug}/`}
          aria-current={current === d.slug ? 'page' : undefined}
        >
          {d.title}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .division-subnav {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .division-subnav .container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .division-subnav__label {
    flex: 0 0 auto;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-800);
  }

  .division-subnav__links {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-block: 0.8rem;
    scrollbar-width: none;
  }

  .division-subnav__links::-webkit-scrollbar {
    display: none;
  }

  .division-subnav__links a {
    flex: 0 0 auto;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--slate);
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .division-subnav__links a:hover {
    border-color: var(--brand);
    color: var(--brand-700);
  }

  .division-subnav__links a[aria-current='page'] {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }

  @media (max-width: 640px) {
    .division-subnav .container {
      align-items: stretch;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
