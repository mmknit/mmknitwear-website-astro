---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/react/HeroSlider';
import Counter from '../components/react/Counter';
import SectionTitle from '../components/SectionTitle.astro';
import BrandWall from '../components/BrandWall.astro';
import CertWall from '../components/CertWall.astro';
import CTASection from '../components/CTASection.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { SITE } from '../data/site';
import { ld, siteUrl } from '../utils/seo';

const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;

const title = 'Knitwear Manufacturer in Bangladesh | M.M. Knitwear Ltd.';
const description =
  'M.M. Knitwear Ltd. — 100% export-oriented knitwear manufacturer in Bangladesh producing 200,000 garments a day since 2001.';
const keywords =
  'knitwear manufacturer in bangladesh, knit composite factory, export oriented garments manufacturer, t-shirt manufacturer bangladesh, circular knitting factory, garment factory gazipur';

const slides = [
  {
    image: u('upload/banner1.webp'),
    title: '100% Export-Oriented Knitwear Manufacturer in Bangladesh',
  },
  {
    image: u('upload/banner2.webp'),
    title: '200,000 Garments Produced Every Day',
  },
  {
    image: u('upload/banner3.webp'),
    title: 'Vertically Integrated Knit Composite Factory',
  },
];

const services = [
  {
    icon: 'upload/service-icon-1.png',
    title: 'High Quality Clothing',
    text: 'All clothes are cut, stitched and finished by hand and undergo a five-stage quality control procedure to ensure your satisfaction.',
  },
  {
    icon: 'upload/service-icon-2.png',
    title: 'Fabric Sourcing',
    text: 'Fabrics are sourced to match your requirements for composition and texture, with dyeing to your exact colour specifications.',
  },
  {
    icon: 'upload/service-icon-1.png',
    title: 'Prototypes & Sampling',
    text: 'For each order we create a prototype for your approval, then commence bulk manufacture once your samples are approved.',
  },
  {
    icon: 'upload/service-icon-3.png',
    title: 'Bulk Manufacture',
    text: 'Bulk manufacture happens on our production lines, quality checked throughout and finished before your items are packaged for delivery.',
  },
];

const stats = [
  { label: 'Production Capacity', end: 200000, suffix: '+', note: 'Pieces per day' },
  { label: 'Factory Space', end: 1523000, suffix: '', note: 'Square feet' },
  { label: 'Annual Turnover', end: 140, suffix: 'M', note: 'US Dollars (2026)' },
  { label: 'Export Markets', end: 10, suffix: '+', note: 'Countries worldwide' },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'M.M. Knitwear Ltd.',
  url: siteUrl + '/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://www.mmknitwear.com/images/logo.png',
  },
  description:
    '100% export-oriented knitwear manufacturer in Bangladesh producing knit garments since 2001, with a vertically integrated factory in Gazipur.',
  foundingDate: '2001',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 10982 },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'House 16, Road 10, Sector 01, Uttara Model Town',
    addressLocality: 'Dhaka',
    postalCode: '1230',
    addressCountry: 'BD',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 23.8759, longitude: 90.3993 },
  areaServed: 'Worldwide',
  telephone: '+8809666768768',
  email: 'info@mmknitwear.com',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+8809666768768',
    contactType: 'customer service',
    email: 'info@mmknitwear.com',
    availableLanguage: ['en', 'bn'],
  },
  sameAs: [
    'https://www.facebook.com/mmknit',
    'https://www.instagram.com/mmknitbd/',
    'https://www.linkedin.com/company/m-m-knitwear-ltd/',
    'https://www.youtube.com/@mmknitwear',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl + '/',
  name: 'M.M. Knitwear Ltd.',
  description: '100% export-oriented knitwear manufacturer in Bangladesh.',
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'en',
};

const jsonLd = [ld(organization), ld(website)];
---

<BaseLayout title={title} description={description} canonical="/" keywords={keywords} jsonLd={jsonLd} preloadImage={slides[0].image} active="home">
  <HeroSlider slides={slides} client:load />

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="What We Do"
        title="A Full-Scale Manufacturing Solution"
        text="Every stage of production — yarn and fabric dyeing, circular knitting, cutting, sewing, finishing, printing, AOP and embroidery — is managed in-house to protect quality, lead time and compliance."
        center
      />
      <div class="grid grid--4">
        {services.map((s, i) => (
          <article class="card feature-card reveal">
            <span class="feature-card__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="feature-card__icon">
              <img src={u(s.icon)} alt={`${s.title} icon`} width="72" height="72" loading="lazy" />
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="split">
        <div class="split__media reveal">
          <img src={u('upload/mm-factory-1281.jpg')} alt="M.M. Knitwear factory in Konabari, Gazipur" loading="lazy" />
          <div class="split__badge">
            <div>
              <strong>2001</strong>
              <span>Established</span>
            </div>
            <div style="width:1px;height:38px;background:var(--line);"></div>
            <div>
              <strong>10,982</strong>
              <span>Employees</span>
            </div>
          </div>
        </div>
        <div class="split__body reveal">
          <SectionTitle
            eyebrow="Our Journey"
            title="One of Bangladesh's Leading Knitwear Manufacturers"
            text="Established in 2001, M.M. Knitwear Ltd. is a 100% export-oriented knitwear manufacturer in Bangladesh, specialising in organic cotton and fast fashion knitwear for global brands, independent boutiques and specialist retailers."
          />
          <p>
            Our fully integrated knit composite facility in Gazipur produces 200,000 garments
            per day across more than 1,523,000 square feet of factory space, supported by a
            workforce of over 10,982 people.
          </p>
          <p>
            We supply knitted apparel including men's t-shirts and pants, women's tops and
            dresses, and kids' hoodies and sweaters to leading international brands such as
            Zara, Pepe Jeans, OVS, Terranova, Springfield, Ulla Popken, Crew Clothing, Sfera,
            Auchan and New Yorker.
          </p>
          <ul class="split__checks" role="list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              Vertically integrated knit composite facility
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              ACCORD, OEKO-TEX, AMFORI BSCI, WRAP &amp; SEDEX certified
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              ISO &amp; OHSAS management systems in place
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="Our Statistics" title="Performance in Numbers" center />
      <div class="stats">
        {stats.map((s) => (
          <div class="stat reveal">
            <div class="stat__label">{s.label}</div>
            <div class="stat__value">
              <Counter end={s.end} suffix={s.suffix} client:idle />
            </div>
            <div class="stat__note">{s.note}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle
        eyebrow="Our Clients"
        title="Trusted by Leading International Brands"
        text="We export knitted apparel to more than 10 countries for brands across Europe, Asia, the USA and Australia."
        center
      />
      <BrandWall />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Compliance"
        title="We Care for Our People and Our Environment"
        text="We maintain 100% compliance with government regulations and all requirements from our clients. Below are some of the compliance certifications we have achieved; this list is not exhaustive."
        center
      />
      <CertWall />
    </div>
  </section>

  <CTASection secondary={{ label: 'Learn More About Us', href: `${base}about-us/` }} />

  <section class="section section--surface">
    <div class="container">
      <SectionTitle eyebrow="Corporate Video" title="Inside Our Factory" center />
      <VideoEmbed src="https://www.youtube.com/embed/ctGUUf4bGCU" title="M.M. Knitwear corporate video" />
    </div>
  </section>
</BaseLayout>

<style>
  .grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 1024px) {
    .grid--4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .grid--4 { grid-template-columns: 1fr; }
  }
</style>
