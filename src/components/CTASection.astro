---
interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondary?: { label: string; href: string };
}

const {
  title = 'Want to know more about us?',
  text = 'Download our company profile for a complete overview of our capabilities, certifications and compliance.',
  ctaLabel = 'Download Company Profile',
  ctaHref,
  secondary,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = ctaHref ?? base + 'upload/Company-Profile-Of-MM-Knitwear-Ltd.pdf';
---

<section class="section">
  <div class="container">
    <div class="cta-banner reveal">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div style="display:flex;gap:.85rem;flex-wrap:wrap;">
        <a class="btn btn--white" href={href} download>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="m7 10 5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
          {ctaLabel}
        </a>
        {secondary && (
          <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>
        )}
      </div>
    </div>
  </div>
</section>
