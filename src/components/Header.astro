---
import MobileNav from './react/MobileNav';
import { divisions } from '../data/divisions';

const base = import.meta.env.BASE_URL;

interface NavItem {
  key: string;
  label: string;
  href: string;
  children?: { key: string; label: string; href: string }[];
}

const DIVISION_LINKS = divisions.map((d) => ({
  key: d.slug,
  label: d.title,
  href: `/projects/${d.slug}/`,
}));

const NAV: NavItem[] = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'about', label: 'About Us', href: '/about-us/' },
  { key: 'compliance', label: 'Compliance', href: '/compliance/' },
  { key: 'projects', label: 'Projects', href: '/projects/', children: DIVISION_LINKS },
  { key: 'portfolio', label: 'Portfolio', href: '/portfolio/' },
];

interface Props {
  active?: string;
}

const { active } = Astro.props;

const pagePath = Astro.url.pathname.replace(/\/+$/, '');
const isActiveChild = (href: string) => pagePath === base.replace(/\/$/, '') + href.slice(0, -1);
---

<header class="site-header">
  <div class="site-header__main">
    <div class="container site-header__inner">
      <a class="logo" href={base} aria-label="M.M. Knitwear Ltd. — Home">
        <img src={base + 'images/logo.png'} alt="M.M. Knitwear Ltd." width="42" height="42" />
      </a>

      <nav class="main-nav" aria-label="Primary">
        {NAV.map((item) =>
          item.children ? (
            <div class="nav-drop">
              <a href={base + item.href.slice(1)} aria-current={active === item.key ? 'page' : undefined}>
                {item.label}
                <svg class="nav-drop__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </a>
              <div class="nav-drop__menu">
                {item.children.map((c) => (
                  <a href={base + c.href.slice(1)} aria-current={isActiveChild(c.href) ? 'page' : undefined}>
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={base + item.href.slice(1)} aria-current={active === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          )
        )}
        <a href={base + 'contact/'} aria-current={active === 'contact' ? 'page' : undefined}>Contact</a>
      </nav>

      <div class="header-cta">
        <MobileNav nav={NAV} active={active} client:idle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header__main {
    background: #fff;
  }

  .nav-drop {
    position: relative;
  }

  .nav-drop > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-drop__chevron {
    width: 13px;
    height: 13px;
    transition: transform 0.2s ease;
  }

  .nav-drop:hover .nav-drop__chevron {
    transform: rotate(180deg);
  }

  .nav-drop__menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    min-width: 270px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem;
    display: grid;
    gap: 0.15rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    z-index: 60;
  }

  .nav-drop:hover .nav-drop__menu,
  .nav-drop:focus-within .nav-drop__menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(6px);
  }

  .nav-drop__menu a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--slate);
    white-space: nowrap;
  }

  .nav-drop__menu a:hover {
    background: var(--surface);
    color: var(--brand-700);
  }

  .nav-drop__menu a::after {
    display: none;
  }
</style>
