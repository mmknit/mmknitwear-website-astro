; padding: 16px 0; list-style: none; display: flex; align-items: center; }\n                                                .faq-item summary::-webkit-details-marker { display: none; }\n                                                .faq-item summary::before { content: '\\25B8'; display: inline-block; margin-right: 10px; font-size: 13px; color: #2d9bea; transition: transform 0.2s ease; flex-shrink: 0; }\n                                                .faq-item[open] summary::before { transform: rotate(90deg); }\n                                                .faq-item summary:hover { color: #1e5fa8; }\n                                                .faq-item p { font-size: 15px; color: #666666; margin: 0 0 16px 23px; line-height: 1.7; }\n                                            </style>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <details class=\"faq-item\">\n                                                    <summary>Where is M.M. Knitwear Ltd. located?</summary>\n                                                    <p>Our head office is at House 16, Road 10, Sector 01, Uttara Model Town, Dhaka, and our factory is at Ambagh Road, Nilnagar, Konabari, Gazipur, Bangladesh.</p>\n                                                </details>\n                                                <details class=\"faq-item\">\n                                                    <summary>What products does M.M. Knitwear manufacture?</summary>\n                                                    <p>We are a 100% export-oriented knitwear manufacturer producing t-shirts, polo shirts, hoodies, sweatshirts, pants and other knit garments for men, women and kids.</p>\n                                                </details>\n                                                <details class=\"faq-item\">\n                                                    <summary>Do you work with international apparel brands?</summary>\n                                                    <p>Yes. We export to more than 10 countries and produce for brands such as Zara, Pepe Jeans, OVS, Terranova, Springfield, Ulla Popken, Crew Clothing, Sfera, Auchan and New Yorker.</p>\n                                                </details>\n                                                <details class=\"faq-item\">\n                                                    <summary>How do I request a quotation or product samples?</summary>\n                                                    <p>Send your requirement to bashir@mmknitwear.com or info@mmknitwear.com, or use the contact form on this page, and our marketing team will respond with pricing and sample lead times.</p>\n                                                </details>\n                                                <details class=\"faq-item\">\n                                                    <summary>What certifications does your factory hold?</summary>\n                                                    <p>Our factory is certified under ACCORD, OEKO-TEX, AMFORI BSCI, WRAP and SEDEX, and operates to ISO and OHSAS standards for quality and safety.</p>\n                                                </details>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n    <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n        <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-pbf-wrapper-full-no-space\">\n            <div class=\"gdlr-core-pbf-element\">\n                <div class=\"gdlr-core-wp-google-map-plugin-item gdlr-core-item-pdlr gdlr-core-item-pdb \" style=\"padding-bottom: 0px;\">\n      