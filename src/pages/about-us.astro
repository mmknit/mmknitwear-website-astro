const title = "About Us | M.M. Knitwear Ltd. - Knitwear Manufacturer in Bangladesh";
const description = "M.M. Knitwear Ltd.: export-oriented knit composite manufacturer in Gazipur, Bangladesh, producing quality apparel since 2001.";
const canonical = "/about-us/";
const jsonLd = [
  "<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"Home\",\n          \"item\": \"https://www.mmknitwear.com/index.html\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"About Us\",\n          \"item\": \"https://www.mmknitwear.com/about-us.html\"\n        }\n      ]\n    }\n    </script>"
];
const headStyle = [
  // none
];
const footerScripts = "";
const content = "<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 115px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                \n\t\t\t\t\t\t\t\t<div class=\"gdlr-core-pbf-column gdlr-core-column-45 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 109px 80px 80px 0px;\" data-sync-height=\"height-3\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 35px;\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h1 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"font-size: 36px;letter-spacing: 0px;text-transform: none;\">About Us<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h1></div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\" style=\"padding-bottom: 0px;\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 15px;\">\n                                                        <p>M.M. Knitwear Ltd. is a 100% export-oriented knit composite manufacturer established in September 2001 in Gazipur, Bangladesh. From our head office in Uttara, Dhaka and our factory at Ambagh Road, Konabari, we design and produce high-quality knitted apparel for leading international brands, independent boutiques and specialist retailers across Europe and beyond.</p>\n                                                        <p>We aim to continue developing with the latest manufacturing technologies available to accommodate large orders and satisfy our clients well. Our strength as a private company enables us to create an organic environment that provides opportunity for our people to grow as we do. M.M. Knitwear Ltd. has already been recognised by many influential business leaders in Bangladesh and is well on its way to becoming an industrial institution in one of the world's rising economies.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-icon-list-item gdlr-core-item-pdlr gdlr-core-item-pdb \" style=\"padding-bottom: 0px;\">\n                                                    <ul>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag\" style=\"color: #4c4c4c;font-size: 16px;width: 16px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear\" style=\"color: #4c4c4c;font-size: 16px;width: 16px;\"></i></span><span class=\"gdlr-core-icon-list-content\"><b>Year of establishment:</b> September 2001.</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag\" style=\"color: #4c4c4c;font-size: 16px;width: 16px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear\" style=\"color: #4c4c4c;font-size: 16px;width: 16px;\"></i></span><span class=\"gdlr-core-icon-list-content\"><b>Annual turnover:</b> 140.00 million US Dollars (2026).</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag\" style=\"color: #4c4c4c;font-size: 16px;width: 16px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear\" style=\"color: #4c4c4c;font-size: 16px;width: 16px;\"></i></span><span class=\"gdlr-core-icon-list-content\"><b>Production capacity:</b> 200,000 pieces/day across 116 production lines with 3,850 sewing machines.</span></li>\n                                                    </ul>\n                                                </div>\n                                            </div>\n\t\t\t\t\t\t\t\t\t\t\t\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-15\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" style=\"padding: 130px 0px 110px 70px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n\t\t\t\t\t\t\t\t\t<div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #f1f0f0 ;\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/mm-factory-1281.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\"></div>\n                                        \n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-left\" style=\"padding: 100px 100px 0px 0px;\" data-sync-height=\"height-1\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #f1f0f0 ;\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/quality-policy.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" style=\"padding: 130px 0px 110px 70px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #f2f2f2 ;\"></div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInRight\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 25px;\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"font-size: 33px;letter-spacing: 0px;text-transform: none;\">Quality Policy<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2></div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\" style=\"padding-bottom: 15px;\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>We strive to achieve customer excellence by exceeding expectations of product quality, performance and delivery. We are committed to implementing quality management systems that conform to international standards. Our drive to build a sustainable business through continuous improvement, quality management, attention to detail and a strict commitment to our buyers’s requirements continues to gain momentum. Thank you to all our clients for making this dream a reality.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            \n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-left\" style=\"padding: 135px 80px 110px 0px;\" data-sync-height=\"height-2\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #ffffff ;\"></div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 35px;\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"font-size: 36px;letter-spacing: 0px;text-transform: none;\">Welfare Facilities<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2></div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\" style=\"padding-bottom: 25px;\">\n                                                    \n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-icon-list-item gdlr-core-item-pdlr gdlr-core-item-pdb  gdlr-core-icon-list-with-background-circle\" style=\"padding-bottom: 0px;\">\n                                                    <ul>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Elected workers' welfare committee (aimed at improving morale, job satisfaction and attendance)</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Canteen service</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Subsidized lunch for employees</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Free snacks on duty</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Full-time free medical service provided by two professional doctors on site</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Child care centre for employees and an annual picnic.</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">In-house prayer facilities for men and women.</span></li>\n                                                        <li class=\" gdlr-core-skin-divider gdlr-core-with-hover\"><span class=\"gdlr-core-icon-list-icon-wrap gdlr-core-skin-e-background\" style=\"background-color: #51b0f3 ;\"><i class=\"gdlr-core-icon-list-icon-hover fa fa-flag gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i><i class=\"gdlr-core-icon-list-icon fa fa-gear gdlr-core-skin-e-content\" style=\"color: #f9f9f9;font-size: 13px;width: 13px;\"></i></span><span class=\"gdlr-core-icon-list-content\">Annual cultural celebration</span></li>\n                                                    </ul>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30\" data-skin=\"Dark\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" style=\"padding: 110px 0px 50px 80px;\" data-sync-height=\"height-2\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #1f1f1f ;\"></div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInRight\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-column-service-item gdlr-core-item-pdb  gdlr-core-left-align gdlr-core-column-service-icon-left gdlr-core-no-caption gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-column-service-media gdlr-core-media-image\" style=\"margin-top: 15px;margin-right: 55px;\"><img src=\"/upload/about-icon-1.png\" alt=\"Compliance icon\" width=\"60\" height=\"60\" loading=\"lazy\"></div>\n                                                    <div class=\"gdlr-core-column-service-content-wrapper\">\n                                                        <div class=\"gdlr-core-column-service-title-wrap\">\n                                                            <h2 class=\"gdlr-core-column-service-title\" style=\"font-size: 21px;text-transform: none;\">Compliance</h2></div>\n                                                        <div class=\"gdlr-core-column-service-content\" style=\"font-size: 14px;\">\n                                                            <p>Our factory maintains full compliance with international laws and standards covering human rights, social compliance, technical compliance, C-TPAT, labour law and other rules and instructions set by the relevant authorities.</p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-column-service-item gdlr-core-item-pdb  gdlr-core-left-align gdlr-core-column-service-icon-left gdlr-core-no-caption gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-column-service-media gdlr-core-media-image\" style=\"margin-top: 15px;margin-right: 55px;margin-left: 5px;\"><img src=\"/upload/about-icon-2.png\" alt=\"Employee and social commitment icon\" width=\"56\" height=\"64\" loading=\"lazy\"></div>\n                                                    <div class=\"gdlr-core-column-service-content-wrapper\">\n                                                        <div class=\"gdlr-core-column-service-title-wrap\">\n                                                            <h2 class=\"gdlr-core-column-service-title\" style=\"font-size: 21px;text-transform: none;\">Employee & Social Commitment</h2></div>\n                                                        <div class=\"gdlr-core-column-service-content\" style=\"font-size: 14px;\">\n                                                            <p>As an organisation, our strength is focused on our employees and the development of their skills, enabling us to offer the best products and services to our customers. Through sponsorship, we also support local, regional and national sports and charity initiatives.</p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-column-service-item gdlr-core-item-pdb  gdlr-core-left-align gdlr-core-column-service-icon-left gdlr-cor