                                </div>
                                <div class="gdlr-core-recent-portfolio-widget gdlr-core-media-image">
                                    <a href="/projects/"><img src="/upload/garments-150x150.png" alt="Garments division" width="150" height="150"  loading="lazy"/><span class="gdlr-core-image-overlay "><i class="gdlr-core-image-overlay-icon icon_link_alt gdlr-core-size-15"  ></i></span></a>
