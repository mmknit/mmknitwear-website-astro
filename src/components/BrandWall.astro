---
import { clientBrands } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<div class="logo-wall">
  {clientBrands.map((n) => (
    <div class="logo-wall__item" title={`Client brand ${n}`}>
      <img
        src={`${base}images/Brands/${n}.png`}
        alt={`Client brand logo ${n}`}
        loading="lazy"
        width="120"
        height="52"
      />
    </div>
  ))}
</div>
