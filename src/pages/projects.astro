const description = "Explore M.M. Knitwear\\u2019s knitting, dyeing, garments, cutting, printing, AOP, embroidery and laundry divisions in Gazipur.";
const canonical = "/projects/";
const jsonLd = [
  "<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"Home\",\n          \"item\": \"https://www.mmknitwear.com/index.html\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"Projects\",\n          \"item\": \"https://www.mmknitwear.com/projects.html\"\n        }\n      ]\n    }\n    </script>"
];
