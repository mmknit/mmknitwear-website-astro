---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CTASection from '../components/CTASection.astro';
import CertWall from '../components/CertWall.astro';
import { ld, breadcrumb, siteUrl } from '../utils/seo';

const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;

const title = 'Compliance & Sustainability | M.M. Knitwear Ltd.';
const description =
  'M.M. Knitwear Ltd. is committed to ethical manufacturing, sustainability and social responsibility across every stage of our vertically integrated knit composite operation.';
const keywords =
  'garment factory compliance bangladesh, sustainable knitwear manufacturing, accords oecko-tex bsci wrap sedex certified factory, ethical garment manufacturing';

const accreditations = [
  { name: 'ACCORD', text: 'Building & fire safety accord for garment factories' },
  { name: 'OEKO-TEX', text: 'Certified safe, sustainable textile products' },
  { name: 'AMFORI BSCI', text: 'Social audit & business social compliance initiative' },
  { name: 'WRAP', text: 'Worldwide responsible accredited production' },
  { name: 'SEDEX', text: 'Supplier ethical data exchange membership' },
  { name: 'ISO & OHSAS', text: 'Quality and occupational health & safety systems' },
];

const initiatives = [
  { title: 'Solar Energy', text: '1,160 KW of solar panel capacity on site', pct: null },
  { title: 'Daylight & LED Lighting', text: 'Energy-efficient lighting throughout the factory', pct: 0.5 },
  { title: 'Exhaust Gas Boiler', text: 'Efficient thermal energy generation', pct: 3.0 },
  { title: 'Reuse & Recycling', text: 'Programmes to reduce waste and emissions', pct: 0.25 },
  { title: 'Sustainable Product Design', text: 'Lower-impact materials and smarter design', pct: null },
  { title: 'Zero Waste Initiatives', text: 'Working toward zero waste across production', pct: null },
];

const csr = [
  'Modern medical facility - 2 units with 12 beds, with full-time free service provided by two professional doctors on site',
  'Child care facility for 100 children of employees',
  'Biological ETP - 280 m\u00B3 for responsible wastewater treatment',
  'Canteen service and subsidized lunch for employees',
  'Elected workers\u2019 welfare committee to improve morale, job satisfaction and attendance',
  'Fire safety systems, controls and regular training',
  '24/7 security personnel and systems',
  'Regular safety and skill development training',
  'In-house prayer facilities for men and women, plus an annual cultural celebration and picnic',
];

const compliancePage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Compliance & Sustainability',
  url: siteUrl + '/compliance/',
  description: 'Ethical manufacturing, sustainability and social responsibility at M.M. Knitwear Ltd.',
  inLanguage: 'en',
};

const jsonLd = [ld(breadcrumb('Compliance & Sustainability', '/compliance/')), ld(compliancePage)];
---

<BaseLayout title={title} description={description} keywords={keywords} canonical="/compliance/" jsonLd={jsonLd} active="compliance">
  <PageHeader eyebrow="Ethics & Responsibility" title="Compliance & Sustainability" crumb="Compliance"
    intro="M.M. Knitwear Ltd. is committed to ethical manufacturing, sustainability and social responsibility across every stage of our vertically integrated knit composite operation in Gazipur, Bangladesh." />

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Global Accreditations"
        title="Certified to the Highest International Standards"
        text="We maintain the highest international standards for quality, safety and ethical manufacturing. Our factories are certified and audited under leading global schemes, including ACCORD, OEKO-TEX, AMFORI BSCI, WRAP and SEDEX, with ISO and OHSAS management systems in place."
      />
      <CertWall />
      <p class="accred-note">
        Certified and audited under {accreditations.map((a) => a.name).join(', ')} — with ISO and OHSAS
        management systems in place.
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle
        eyebrow="Sustainability"
        title="Our Path to a Greener Future"
        text="We have set a plan to reduce 14% of our GHG emissions by the year 2029 through the following initiatives."
      />
      <div class="split">
        <ul class="initiatives" role="list">
          {initiatives.map((it) => (
            <li class="reveal">
              <div class="initiatives__head">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <h3>{it.title}</h3>
                {it.pct !== null && <strong>&minus;{it.pct}%</strong>}
              </div>
              <p>{it.text}</p>
            </li>
          ))}
        </ul>
        <div class="split__media reveal">
          <img
            src={u('upload/ghg-emission-chart.jpg')}
            alt="GHG emission reduction target chart from 99 in 2024 to 86 by 2029"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Corporate Social Responsibility"
        title="Our People Come First"
        text="We are fully committed to social responsibility and worker welfare. Our comprehensive CSR programmes include:"
      />
      <div class="csr-grid">
        {csr.map((c) => (
          <div class="csr-item reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span>{c}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle
        eyebrow="Environmental Compliance"
        title="Protecting the Environment"
        text="We follow strict environmental safety regulations to avoid pollution. Our biological effluent treatment plant (ETP) with 280,000 litres per hour capacity ensures responsible wastewater treatment."
      />
      <p class="env-note">
        We are committed to sustainable manufacturing practices that minimise our environmental
        footprint, from energy-efficient machinery to waste reduction and lower plastic
        consumption across our facilities.
      </p>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .accred-note {
    max-width: 760px;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
  }

  .initiatives {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .initiatives li {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.35rem 1.5rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .initiatives li:hover {
    transform: translateX(6px);
    box-shadow: var(--shadow);
  }

  .initiatives__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .initiatives__head svg {
    width: 20px;
    height: 20px;
    color: var(--brand);
  }

  .initiatives__head h3 { margin-bottom: 0; font-size: 1.05rem; }

  .initiatives__head strong {
    margin-left: auto;
    color: #2e8b57;
    font-family: var(--font-head);
    font-size: 0.9rem;
  }

  .initiatives li p { font-size: 0.93rem; }

  .csr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 860px) {
    .csr-grid { grid-template-columns: 1fr; }
  }

  .csr-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1.35rem 1.4rem;
    font-size: 0.97rem;
    color: var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .csr-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .csr-item svg {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: #2e8b57;
    margin-top: 0.15rem;
  }

  .env-note {
    max-width: 760px;
    font-size: 1.0625rem;
  }
</style>
