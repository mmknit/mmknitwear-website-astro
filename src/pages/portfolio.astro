---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import CTASection from '../components/CTASection.astro';
import { ld, breadcrumb, siteUrl } from '../utils/seo';

const base = import.meta.env.BASE_URL;

const title = 'Knitwear Portfolio & Product Gallery | M.M. Knitwear Ltd.';
const description =
  'Browse M.M. Knitwear\u2019s knitwear collection — t-shirts, polo shirts, hoodies, dresses and joggers for global brands.';
const keywords =
  'knitwear product gallery, t-shirt manufacturer, polo shirt supplier bangladesh, hoodie manufacturer, knit garments collection';

const images = Array.from({ length: 28 }, (_, i) => `${base}images/Picture/${i + 1}.png`);

const portfolioPage = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Knitwear Portfolio & Product Gallery',
  url: siteUrl + '/portfolio/',
  description: 'Product collection of M.M. Knitwear Ltd.',
  about: 'Knit garments produced by M.M. Knitwear Ltd.',
  numberOfItems: images.length,
  inLanguage: 'en',
};

const jsonLd = [ld(breadcrumb('Portfolio', '/portfolio/')), ld(portfolioPage)];
---

<BaseLayout title={title} description={description} keywords={keywords} canonical="/portfolio/" jsonLd={jsonLd} active="portfolio">
  <PageHeader eyebrow="Latest Collection" title="Portfolio" crumb="Portfolio"
    intro="From the latest collection — all types of knit products, especially t-shirts, polo shirts, henley, jogger, leggings, bermuda, dresses, sweatshirts, vests, tank tops, skirts, bodysuits, coveralls, nightwear and loungewear." />

  <section class="section">
    <div class="container">
      <PortfolioGrid images={images} />
    </div>
  </section>

  <CTASection
    title="Have a design in mind?"
    text="Send us your requirement and our marketing team will respond with pricing and sample lead times."
    ctaLabel="Contact Us"
    ctaHref={`${base}contact/`}
  />
</BaseLayout>
