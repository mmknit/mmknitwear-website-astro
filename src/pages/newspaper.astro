---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CTASection from '../components/CTASection.astro';
import { ld, breadcrumb, siteUrl } from '../utils/seo';

const title = 'In the News & Media | M.M. Knitwear Ltd.';
const description =
  'M.M. Knitwear Ltd. in the news — links to coverage in Bangladesh\u2019s leading national dailies and industry publications.';
const keywords =
  'mm knitwear news, bangladesh knitwear industry news, garment exporter news, knit composite factory media coverage';

const news = [
  { name: 'Prothom Alo', url: 'https://www.prothomalo.com/' },
  { name: 'Kaler Kantho', url: 'http://www.kalerkantho.com/' },
  { name: 'BD Pratidin', url: 'http://www.bd-pratidin.com/' },
  { name: 'Ittefaq', url: 'http://www.ittefaq.com.bd/' },
  { name: 'Jugantor', url: 'https://www.jugantor.com/' },
  { name: 'Amader Somoy', url: 'http://dainikamadershomoy.com/' },
  { name: 'Manobjamin', url: 'http://www.mzamin.com/index.php' },
  { name: 'Amar Desh', url: 'https://amar-desh24.com/bangla/' },
  { name: 'E-Prothom Alo', url: 'http://epaperna.prothomalo.com/' },
  { name: 'Bangla News 24', url: 'https://www.banglanews24.com/' },
  { name: 'Samakal', url: 'http://samakal.com/' },
  { name: 'ESPN-Cricinfo', url: 'http://www.espncricinfo.com/' },
];

const newsPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'In the News & Media',
  url: siteUrl + '/newspaper/',
  description: 'M.M. Knitwear Ltd. media coverage links',
  inLanguage: 'en',
};

const jsonLd = [ld(breadcrumb('In the News', '/newspaper/')), ld(newsPage)];
---

<BaseLayout title={title} description={description} keywords={keywords} canonical="/newspaper/" jsonLd={jsonLd} active="news">
  <PageHeader eyebrow="Media Coverage" title="Newspaper Links" crumb="In the News"
    intro="M.M. Knitwear Ltd. has been featured in Bangladesh's leading national dailies and industry publications. Browse the links below, and check back regularly as we add more coverage." />

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="Press" title="Featured in the National Press" />
      <div class="news-grid">
        {news.map((n) => (
          <a class="card news-card reveal" href={n.url} target="_blank" rel="noreferrer">
            <h3>{n.name}</h3>
            <span class="arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
