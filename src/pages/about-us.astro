---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import CTASection from '../components/CTASection.astro';
import { ld, breadcrumb, siteUrl } from '../utils/seo';

const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;

const title = 'About Us | M.M. Knitwear Ltd. – Knitwear Manufacturer in Bangladesh';
const description =
  'Founded in September 2001, M.M. Knitwear Ltd. is a 100% export-oriented knit composite manufacturer in Gazipur, Bangladesh with 10,982 employees and 200,000 pieces of daily production capacity.';
const keywords =
  'about mm knitwear, knit composite manufacturer bangladesh, export oriented garment factory, garment factory gazipur, mm knitwear history';

const quickFacts = [
  { label: 'Year of Establishment', value: 'September 2001' },
  { label: 'Annual Turnover', value: '$140M USD (2026)' },
  { label: 'Production Capacity', value: '200,000 pcs/day' },
  { label: 'Production Lines', value: '116 lines / 3,850 machines' },
];

const welfare = [
  'Elected workers\u2019 welfare committee to improve morale, job satisfaction and attendance',
  'Canteen service with subsidized lunch for employees',
  'Free snacks on duty',
  'Full-time free medical service provided by two professional doctors on site',
  'Child care centre for employees and an annual picnic',
  'In-house prayer facilities for men and women',
  'Annual cultural celebration',
];

const pillars = [
  {
    icon: 'upload/about-icon-1.png',
    title: 'Compliance',
    text: 'Our factory maintains full compliance with international laws and standards covering human rights, social compliance, technical compliance, C-TPAT, labour law and other rules set by the relevant authorities.',
  },
  {
    icon: 'upload/about-icon-2.png',
    title: 'Employee & Social Commitment',
    text: 'Our strength is focused on our employees and the development of their skills, enabling us to offer the best products and services. Through sponsorship we also support local, regional and national sports and charity initiatives.',
  },
  {
    icon: 'upload/about-icon-3.png',
    title: 'Sustainable Development',
    text: 'We continuously work to manufacture more sustainably and reduce plastic consumption. All facilities maintain OEKO-TEX and other compliances to reduce energy use, improve waste management and ensure a safe working environment.',
  },
];

const facilities = [
  { label: 'Area of Factory', value: '15,23,000', note: 'Square feet' },
  { label: 'Employees', value: '10,982', note: 'Male 7,044 (64%) / Female 3,938 (36%)' },
  { label: 'Garments Capacity', value: '200,000', note: 'Pcs per day across 116 lines / 3,850 machines' },
  { label: 'Fabric Capacity', value: '45 + 45', note: 'Knitting & dyeing, tons per day' },
];

const embellishment = [
  { label: 'All Over Print', value: '15', note: 'Tons per day' },
  { label: 'Placement Print', value: '200,000', note: 'Pcs per day' },
  { label: 'Embroidery', value: '50,000', note: 'Pcs per day' },
];

const turnover = [
  { year: '2022', value: 90 },
  { year: '2023', value: 115 },
  { year: '2024', value: 120 },
  { year: '2025', value: 125 },
  { year: '2026', value: 118 },
];

const markets = [
  { country: 'Spain', pct: 35.4 },
  { country: 'Germany', pct: 19.0 },
  { country: 'France', pct: 18.3 },
  { country: 'Italy', pct: 10.2 },
  { country: 'Asia', pct: 7.4 },
  { country: 'USA', pct: 4.0 },
  { country: 'Australia', pct: 2.0 },
  { country: 'UK', pct: 1.4 },
];

const pieColors = ['#00c2ff', '#0ea5e9', '#0891b2', '#0e7490', '#155e75', '#34d399', '#f59e0b', '#f43f5e'];
let pieAcc = 0;
const pieSegments = markets.map((m, i) => {
  const from = Math.round(pieAcc * 10) / 10;
  pieAcc += m.pct;
  const to = Math.round(pieAcc * 10) / 10;
  return `${pieColors[i % pieColors.length]} ${from}% ${to}%`;
});
const pieGradient = `conic-gradient(${pieSegments.join(', ')})`;

const buildings = [
  { name: 'Building 1', size: '78,282 sqft' },
  { name: 'Building 2', size: '1,33,666 sqft' },
  { name: 'Building 3', size: '55,684 sqft' },
  { name: 'Building 4', size: '71,901 sqft' },
  { name: 'Building 5', size: '5,89,000 sqft' },
  { name: 'Building 6', size: '36,898 sqft' },
  { name: 'Building 7', size: '67,996 sqft' },
  { name: 'Building 8', size: '4,200 sqft' },
  { name: 'Building 9', size: '49,140 sqft' },
  { name: 'Building 10', size: '19,122 sqft' },
];

const extras = [
  { name: 'Mamun Knitwear', size: '1,66,137 sqft' },
  { name: 'Shed 1', size: '45,000 sqft' },
  { name: 'Shed 2', size: '73,200 sqft' },
  { name: 'ETP 01', size: '6,000 sqft' },
  { name: 'ETP 02', size: '29,759 sqft' },
];

const team = [
  {
    name: 'Mofizul Islam',
    role: 'Managing Director',
    img: 'upload/team-mofizul.jpg',
    href: 'about-us/leadership/#mofizul-islam',
  },
  {
    name: 'Mamunur Rashid',
    role: 'Director',
    img: 'upload/team-mamunur.jpg',
    href: 'about-us/leadership/#mamunur-rashid',
  },
];

const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About M.M. Knitwear Ltd.',
  url: siteUrl + '/about-us/',
  description,
  mainEntity: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'en',
};

const jsonLd = [ld(breadcrumb('About Us', '/about-us/')), ld(aboutPage)];
---

<BaseLayout title={title} description={description} keywords={keywords} canonical="/about-us/" jsonLd={jsonLd} active="about">
  <PageHeader eyebrow="Who We Are" title="About Us" crumb="About Us"
    intro="M.M. Knitwear Ltd. is a 100% export-oriented knit composite manufacturer established in September 2001 in Gazipur, Bangladesh." />

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__body reveal">
          <SectionTitle eyebrow="Our Story" title="Built on Quality Since 2001" />
          <p>
            From our head office in Uttara, Dhaka and our factory at Ambagh Road, Konabari, we
            design and produce high-quality knitted apparel for leading international brands,
            independent boutiques and specialist retailers across Europe and beyond.
          </p>
          <p>
            We aim to continue developing with the latest manufacturing technologies to
            accommodate large orders and satisfy our clients well. Our strength as a private
            company enables us to create an organic environment that provides opportunity for
            our people to grow as we do.
          </p>
          <p>
            M.M. Knitwear Ltd. has been recognised by many influential business leaders in
            Bangladesh and is well on its way to becoming an industrial institution in one of
            the world's rising economies.
          </p>
        </div>
        <div class="split__media reveal">
          <img src={u('upload/main-banner.jpg')} alt="M.M. Knitwear factory" loading="lazy" />
        </div>
      </div>

      <div class="quickfacts">
        {quickFacts.map((f) => (
          <div class="quickfacts__item">
            <strong>{f.value}</strong>
            <span>{f.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle eyebrow="Quality Policy" title="Excellence in Everything We Do" />
      <p class="lead">
        We strive to achieve customer excellence by exceeding expectations of product quality,
        performance and delivery. We are committed to implementing quality management systems
        that conform to international standards. Our drive to build a sustainable business
        through continuous improvement, quality management, attention to detail and a strict
        commitment to our buyers&rsquo; requirements continues to gain momentum.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pillars">
        <div class="pillars__list">
          <h3>Welfare Facilities</h3>
          <ul role="list">
            {welfare.map((w) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {w}
              </li>
            ))}
          </ul>
        </div>
        <div class="pillars__grid">
          {pillars.map((p) => (
            <div class="card pillar reveal">
              <div class="pillar__icon">
                <img src={u(p.icon)} alt="" width="56" height="56" loading="lazy" />
              </div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle eyebrow="Facilities at a Glance" title="Scale That Meets Demand" center />
      <div class="stats stats--4">
        {facilities.map((f) => (
          <div class="stat reveal">
            <div class="stat__value" style="font-size:1.9rem;">{f.value}</div>
            <div class="stat__label">{f.label}</div>
            <div class="stat__note">{f.note}</div>
          </div>
        ))}
      </div>
      <div class="mini-stats">
        {embellishment.map((e) => (
          <div class="mini-stat reveal">
            <strong>{e.value}</strong>
            <span>{e.label}</span>
            <small>{e.note}</small>
          </div>
        ))}
      </div>
      <p class="center-note">
        We produce all types of knit products, especially T-Shirts, Polo Shirts, Henley, Jogger,
        Leggings, Bermuda, Dresses, Sweatshirts, Vests, Tank Tops, Skirts, Bodysuits, Coveralls,
        Nightwear and Loungewear.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="Our Business Growth" title="A Story of Consistent Growth" center />
      <div class="growth">
        <div class="growth__chart reveal">
          <h3>Annual Turnover ($M)</h3>
          <div class="bars">
            {turnover.map((t) => (
              <div class="bar" title={`$${t.value}M`}>
                <span class="bar__val">${t.value}M</span>
                <span class="bar__fill" style={`height:${(t.value / 125) * 100}%`}></span>
                <span class="bar__year">{t.year}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="growth__share reveal">
          <h3>Business Share</h3>
          <div class="pie-wrap">
            <div class="pie" style={`background:${pieGradient}`} role="img" aria-label="Export market share breakdown by country"></div>
            <ul class="pie-legend" role="list">
              {markets.map((m, i) => (
                <li>
                  <span class="pie-legend__dot" style={`background:${pieColors[i % pieColors.length]}`} aria-hidden="true"></span>
                  <span>{m.country}</span>
                  <strong>{m.pct}%</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="split">
        <div class="split__body reveal">
          <SectionTitle eyebrow="Building Description" title="A Campus Built for Scale" />
          <p>
            Our factory campus in Konabari, Gazipur spreads over 10 buildings, additional sheds
            and ETP units, covering a total area of 15,23,000 sqft.
          </p>
          <ul class="buildings" role="list">
            {buildings.map((b) => (
              <li><span>{b.name}</span><strong>{b.size}</strong></li>
            ))}
          </ul>
          <p class="extra-sheds">
            {extras.map((e) => `${e.name}: ${e.size}`).join(' \u00B7 ')}
          </p>
        </div>
        <div class="split__media reveal">
          <img src={u('upload/building-map.jpg')} alt="M.M. Knitwear Ltd. building layout map" loading="lazy" />
        </div>
      </div>
      <p class="center-note">
        Buildings house yarn storage, knitting, dyeing, printing, embroidery, garments units,
        all over print, warehouse, accessories storage and medical facilities, with dedicated
        free space for future expansion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="Leadership" title="Meet the Team" center />
      <div class="team-grid">
        {team.map((t) => (
          <a class="team-card reveal" href={u(t.href)}>
            <img src={u(t.img)} alt={`${t.name}, ${t.role}`} loading="lazy" width="400" height="400" />
            <div class="team-card__body">
              <h3>{t.name}</h3>
              <span class="team-card__role">{t.role}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="team-more">
        <a class="btn btn--outline" href={u('about-us/leadership/')}>
          View Full Profiles <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle eyebrow="Corporate Video" title="Inside Our Factory" center />
      <VideoEmbed src="https://www.youtube.com/embed/ctGUUf4bGCU" title="M.M. Knitwear corporate video" />
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .quickfacts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .quickfacts__item {
    text-align: center;
    padding: 1.75rem 1rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .quickfacts__item strong {
    display: block;
    font-family: var(--font-head);
    font-size: 1.15rem;
    color: var(--brand-800);
  }

  .quickfacts__item span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .quickfacts { grid-template-columns: repeat(2, 1fr); }
  }

  .lead {
    font-size: 1.125rem;
    color: var(--slate);
    max-width: 820px;
  }

  .pillars {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .pillars { grid-template-columns: 1fr; }
  }

  .pillars__list h3 {
    margin-bottom: 1.25rem;
  }

  .pillars__list ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .pillars__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.98rem;
    color: var(--ink);
  }

  .pillars__list svg {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: var(--brand);
    margin-top: 0.15rem;
  }

  .pillars__grid {
    display: grid;
    gap: 1.25rem;
  }

  .pillar {
    padding: 1.75rem;
    display: grid;
    grid-template-columns: 64px 1fr;
    grid-template-rows: auto auto;
    column-gap: 1.25rem;
  }

  .pillar__icon {
    grid-row: 1 / span 2;
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: var(--surface-2);
    display: grid;
    place-items: center;
    padding: 0.8rem;
  }

  .pillar__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pillar h3 { margin-bottom: 0.5rem; }
  .pillar p { font-size: 0.95rem; }

  @media (max-width: 560px) {
    .pillar { grid-template-columns: 1fr; }
    .pillar__icon { grid-row: auto; margin-bottom: 0.5rem; }
  }

  .stats--4 { grid-template-columns: repeat(4, 1fr); }

  .mini-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .mini-stat {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
  }

  .mini-stat strong {
    display: block;
    font-family: var(--font-head);
    font-size: 1.9rem;
    color: var(--brand);
    line-height: 1;
  }

  .mini-stat span {
    display: block;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--ink);
    margin-top: 0.4rem;
  }

  .mini-stat small {
    color: var(--muted);
  }

  .center-note {
    text-align: center;
    max-width: 820px;
    margin: 1.75rem auto 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .team-more {
    margin-top: 2rem;
    text-align: center;
  }

  .growth {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  @media (max-width: 860px) {
    .growth { grid-template-columns: 1fr; }
  }

  .growth__chart,
  .growth__share {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 1.75rem;
  }

  .growth__chart {
    display: flex;
    flex-direction: column;
  }

  .growth h3 { margin-bottom: 1.5rem; }

  .bars {
    flex: 1;
    min-height: 220px;
    display: flex;
    align-items: flex-end;
    gap: 0.85rem;
    padding-top: 1.5rem;
  }

  .bar {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .bar__val {
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--brand-800);
  }

  .bar__fill {
    width: 100%;
    border-radius: 8px 8px 0 0;
    background: linear-gradient(180deg, var(--brand), var(--brand-600));
    transition: height 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bar__year {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }

  .pie-wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .pie {
    width: min(190px, 34vw);
    aspect-ratio: 1;
    border-radius: 50%;
    -webkit-mask: radial-gradient(farthest-side, transparent 56%, #000 57%);
    mask: radial-gradient(farthest-side, transparent 56%, #000 57%);
  }

  .pie-legend {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.9rem;
  }

  .pie-legend li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }

  .pie-legend__dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex: 0 0 auto;
  }

  .pie-legend strong {
    color: var(--brand-800);
    margin-left: auto;
  }

  @media (max-width: 520px) {
    .pie-wrap {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }

  .buildings {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
  }

  .buildings li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px dashed var(--line);
    padding-block: 0.45rem;
    font-size: 0.95rem;
  }

  .buildings span { color: var(--slate); }
  .buildings strong { color: var(--ink); }

  .extra-sheds {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
