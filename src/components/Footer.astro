                        </div>
                    </div>
                </div>
            </div>
            <div class="kleanity-copyright-wrapper">
                <div class="kleanity-copyright-container kleanity-container">
                    <div class="kleanity-copyright-text kleanity-item-pdlr">Copyright 2026 M.M. Knitwear Ltd.</div>
                    <div class="kleanity-copyright-text kleanity-item-pdlr" style="margin-top: 10px;">Share this page: <a href={fb} target="_blank" rel="noopener nofollow">Facebook</a> &nbsp;|&nbsp; <a href={li} target="_blank" rel="noopener nofollow">LinkedIn</a> &nbsp;|&nbsp; <a href={tw} target="_blank" rel="noopener nofollow">X (Twitter)</a></div>
