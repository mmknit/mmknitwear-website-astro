                            <h3 class="kleanity-widget-title"><span class="kleanity-widget-head-text">Our Projects</span><span class="kleanity-widget-head-divider"></span></h3><span class="clear"></span>
                            <div class="gdlr-core-recent-portfolio-widget-wrap clearfix">
                                <div class="gdlr-core-recent-portfolio-widget gdlr-core-media-image">
                                    <a href="/projects/"><img src="/upload/knitting-150x150.png" alt="Knitting division" width="150" height="150"  loading="lazy"/><span class="gdlr-core-image-overlay "><i class="gdlr-core-image-overlay-icon icon_link_alt gdlr-core-size-15"  ></i></span></a>
                                </div>
                                <div class="gdlr-core-recent-portfolio-widget gdlr-core-media-image">
