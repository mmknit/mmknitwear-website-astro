---
interface Props {
  active?: 'home' | 'about' | 'compliance' | 'projects' | 'portfolio' | 'contact';
}

const { active } = Astro.props;

const cls = (k) => {
  const base = 'menu-item menu-item-has-children kleanity-normal-menu';
  const home = 'menu-item menu-item-home menu-item-has-children kleanity-normal-menu';
  const mega = 'menu-item menu-item-has-children kleanity-mega-menu';
  const leaf = k === 'home' ? home : k === 'contact' ? mega : base;
  return active === k ? `${leaf} current-menu-item` : leaf;
};
---

<div class="kleanity-header-background-transparent">
    <header class="kleanity-header-wrap kleanity-header-style-plain  kleanity-style-menu-right kleanity-sticky-navigation kleanity-style-slide">
        <div class="kleanity-header-background"></div>
        <div class="kleanity-header-container  kleanity-header-full">
            <div class="kleanity-header-container-inner clearfix">
                <div class="kleanity-logo  kleanity-item-pdlr">
                    <div class="kleanity-logo-inner">
                        <a href="/"><img src="/images/logo.png" alt="M.M. Knitwear Ltd. logo" /></a>
                    </div>
                </div>
                <div class="kleanity-navigation kleanity-item-pdlr clearfix ">
                    <div class="kleanity-main-menu" id="kleanity-main-menu">
                        <ul id="menu-main-navigation-1" class="sf-menu">
                            <li class={cls('home')}><a href="/" class="sf-with-ul-pre">Home</a>
                            </li>
                            <li class={cls('about')}><a href="/about-us/" class="sf-with-ul-pre">About Us</a>
                            </li>
                            <li class={cls('compliance')}><a href="/compliance/" class="sf-with-ul-pre">Compliance</a>
                            </li>
                            <li class={cls('projects')}><a href="/projects/" class="sf-with-ul-pre">Projects</a>
                            </li>
                            <li class={cls('portfolio')}><a href="/portfolio/" class="sf-with-ul-pre">portfolio</a>
                            </li>
                            <li class={cls('contact')}><a href="/contact/" class="sf-with-ul-pre">Contact</a>
                            </li>
                        </ul>
                        <div class="kleanity-navigation-slide-bar" id="kleanity-navigation-slide-bar"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>
</div>
