---
interface Props {
  active?: 'home' | 'about' | 'compliance' | 'projects' | 'portfolio' | 'contact';
}

const { active } = Astro.props;

const cls = (k) => {
  const base = 'menu-item menu-item-has-children';
  const home = 'menu-item menu-item-home menu-item-has-children';
  return (active === k ? (k === 'home' ? `${home} current-menu-item` : `${base} current-menu-item`) : k === 'home' ? home : base);
};
---

<div class="kleanity-mobile-header-wrap">
    <div class="kleanity-mobile-header kleanity-header-background kleanity-style-slide" id="kleanity-mobile-header">
        <div class="kleanity-mobile-header-container kleanity-container">
            <div class="kleanity-logo  kleanity-item-pdlr">
                <div class="kleanity-logo-inner">
                    <a href="/"><img src="/images/logo.png" alt="M.M. Knitwear Ltd. logo" /></a>
                </div>
            </div>
            <div class="kleanity-mobile-menu-right">
                <div class="kleanity-mobile-menu"><a class="kleanity-mm-menu-button kleanity-mobile-menu-button kleanity-mobile-button-hamburger-with-border" href="#kleanity-mobile-menu"><i class="fa fa-bars" ></i></a>
                    <div class="kleanity-mm-menu-wrap kleanity-navigation-font" id="kleanity-mobile-menu" data-slide="right">
                        <ul id="menu-main-navigation" class="m-menu">
                            <li class={cls('home')}><a href="/">Home</a>
                            </li>
                            <li class={cls('about')}><a href="/about-us/">About Us</a>
                            </li>
                            <li class={cls('compliance')}><a href="/compliance/">Compliance</a>
                            </li>
                            <li class={cls('projects')}><a href="/projects/">Projects</a>
                            </li>
                            <li class={cls('portfolio')}><a href="/portfolio/">portfolio</a>
                            </li>
                            <li class={cls('contact')}><a href="/contact/">Contact</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
