---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { SITE } from '../data/site';
import { ld, breadcrumb, siteUrl } from '../utils/seo';

const title = 'Contact Us | M.M. Knitwear Ltd. – Dhaka & Gazipur, Bangladesh';
const description =
  'Contact M.M. Knitwear Ltd. — Uttara, Dhaka head office and Konabari, Gazipur factory. Call, email or use the form for pricing.';
const keywords =
  'contact mm knitwear, garment manufacturer bangladesh contact, knitwear supplier email, knit composite factory phone, dhaka garment factory address';

const faqs = [
  {
    q: 'Where are your offices located?',
    a: 'Our head office is at House 16, Road 10, Sector 01, Uttara Model Town, Dhaka, and our factory is at Ambagh Road, Nilnagar, Konabari, Gazipur, Bangladesh.',
  },
  {
    q: 'What products do you manufacture?',
    a: 'We are a 100% export-oriented knitwear manufacturer producing t-shirts, polo shirts, hoodies, sweatshirts, pants and other knit garments for men, women and kids.',
  },
  {
    q: 'Do you export internationally?',
    a: 'Yes. We export to more than 10 countries and produce for brands such as Zara, Pepe Jeans, OVS, Terranova, Springfield, Ulla Popken, Crew Clothing, Sfera, Auchan and New Yorker.',
  },
  {
    q: 'How can I get a quotation?',
    a: 'Send your requirement to bashir@mmknitwear.com or info@mmknitwear.com, or use the contact form on this page, and our marketing team will respond with pricing and sample lead times.',
  },
  {
    q: 'What certifications does your factory hold?',
    a: 'Our factory is certified under ACCORD, OEKO-TEX, AMFORI BSCI, WRAP and SEDEX, and operates to ISO and OHSAS standards for quality and safety.',
  },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'M.M. Knitwear Ltd.',
  url: siteUrl + '/contact/',
  email: 'mailto:info@mmknitwear.com',
  telephone: '+8809666768768',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'House 16, Road 10, Sector 01, Uttara Model Town',
    addressLocality: 'Dhaka',
    postalCode: '1230',
    addressCountry: 'BD',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+8809666768768',
    contactType: 'customer service',
    email: 'info@mmknitwear.com',
    availableLanguage: ['en', 'bn'],
  },
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonLd = [
  ld(breadcrumb('Contact', '/contact/')),
  ld(organization),
  ld(faqPage),
];

const subject = encodeURIComponent('Inquiry from M.M. Knitwear website');
const mailto = `mailto:${SITE.email}?subject=${subject}`;
---

<BaseLayout title={title} description={description} keywords={keywords} canonical="/contact/" jsonLd={jsonLd} active="contact">
  <PageHeader eyebrow="Get in Touch" title="Contact Us" crumb="Contact"
    intro="Whether you have a question about our capabilities, certifications or pricing — our team is ready to help." />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="card info-card reveal">
          <div class="info-card__icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2Z" />
            </svg>
          </div>
          <h3>Phone</h3>
          <p>Head Office</p>
          <a href={`tel:${SITE.phoneHeadRaw}`}>{SITE.phoneHead}</a>
          <p style="margin-top:.9rem;">Factory</p>
          <a href={`tel:${SITE.phoneFactoryRaw}`}>{SITE.phoneFactory}</a>
        </div>

        <div class="card info-card reveal">
          <div class="info-card__icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </div>
          <h3>Email</h3>
          <p>Marketing &amp; Business Development</p>
          <a href={`mailto:${SITE.mktEmail}`}>{SITE.mktEmail}</a>
          <p style="margin-top:.9rem;">General Inquiries</p>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>

        <div class="card info-card reveal">
          <div class="info-card__icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <h3>Head Office</h3>
          <p>{SITE.headOffice}</p>
          <a href={SITE.headOfficeMap} target="_blank" rel="noreferrer">View Head Office on Google Map &rarr;</a>
          <p style="margin-top:.9rem;"><strong>Factory</strong></p>
          <p>{SITE.factory}</p>
          <a href={SITE.factoryMap} target="_blank" rel="noreferrer">View Factory on Google Map &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionTitle eyebrow="Send a Message" title="Leave Us Your Message" center />
      <div class="form-card" style="max-width:820px;margin-inline:auto;">
        <form action={mailto} method="get">
          <div class="form-grid">
            <div class="field">
              <label for="name">Your Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" placeholder="Full name" />
            </div>
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" autocomplete="organization" placeholder="Company name (optional)" />
            </div>
            <div class="field">
              <label for="email">Email Address</label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+880 ..." />
            </div>
            <div class="field field--full">
              <label for="message">Your Message</label>
              <textarea id="message" name="body" required placeholder="Tell us about your product requirements, quantities and target markets..."></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn--primary" style="margin-top:1.25rem;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m22 2-7 20-4-9-9-4Z" />
              <path d="M22 2 11 13" />
            </svg>
            Send Message
          </button>
          <p class="form-note">
            Submitting opens your email app with your message ready to send to {SITE.email}. Click
            Send in your email client to complete.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="Our Factory" title="Find Us on the Map" center />
      <MapEmbed src={SITE.factoryEmbed} title="M.M. Knitwear factory location, Konabari, Gazipur" />

      <div class="faq-block">
        <SectionTitle eyebrow="FAQ" title="Frequently Asked Questions" center />
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                {f.q}
                <span class="faq-item__icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-item__body">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.faq-item').forEach((item) => {
    item.addEventListener('click', (e) => {
      if (e.target.closest('summary')) return;
      if (!item.hasAttribute('open')) item.setAttribute('open', '');
    });
  });
</script>
