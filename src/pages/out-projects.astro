---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Knitting Division | M.M. Knitwear Ltd.";
const description = "Inside M.M. Knitwear\\u2019s knitting division: 225 sets of machines, 80,000 sq ft and 45 tons of daily fabric capacity in Gazipur.";
const canonical = "/out-projects/";
const jsonLd = [
  "<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"Home\",\n          \"item\": \"https://www.mmknitwear.com/index.html\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"Projects\",\n          \"item\": \"https://www.mmknitwear.com/out-projects.html\"\n        }\n      ]\n    }\n    </script>"
];
const headStyle = [
  // none
];
const footerScripts = "";
const content = "<div class=\"gdlr-core-pbf-section\">\n                        <div class=\"gdlr-core-pbf-section-container gdlr-core-container clearfix\">\n                            <div class=\"gdlr-core-pbf-element\">\n                                                                    <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                        <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                            <p>M.M. Knitwear Ltd. operates one of the largest knitting divisions in Gazipur, Bangladesh. Our knitting machines produce weft-knitted fabrics for the t-shirts, tops, hoodies, sweaters and joggers we manufacture for leading international apparel brands.</p>\n                                            <p><a href=\"/projects/\">View all production divisions &rarr;</a></p>\n                                        </div>\n                                    </div>\n                                    <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 20px;\">\n                                        <div class=\"gdlr-core-title-item-title-wrap \">\n                                            <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \"     style=\"letter-spacing: 0px;text-transform: none;\">225 Knitting Machines<span                                class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2></div>\n                                    </div>\n                                    <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                        <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                            <p>Our circular knitting unit has 225 sets of machines with 20GG, 24GG   and 28GG cylinders to produce all types of weft-knitted fabric, complemented by 28 flat knit machines, 6     narrow fabric machines and 14 units of fabric testing machinery. Machine brands include Fukuhara, Fukuhama   and Jiunn Long.</p>\n                                        </div>\n                                    </div>\n                                    <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 20px;\">\n                                        <div class=\"gdlr-core-title-item-title-wrap \">\n                                            <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">80,000 Sq Ft Floor Space<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2></div>\n                                    </div>\n                                    <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                        <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                            <p>The knitting unit occupies 80,000 square feet of floor space at our Konabari complex in Gazipur, keeping yarn sourcing, knitting, testing and quality control under one roof.</p>\n                                        </div>\n                                    </div>\n                                    <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 20px;\">\n                                        <div class=\"gdlr-core-title-item-title-wrap \">\n                                            <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \"     style=\"letter-spacing: 0px;text-transform: none;\">45 TON Daily Knitting Capacity<span                     class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2></div>\n                                    </div>\n                                    <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                        <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                            <p>Our daily knitting capacity of 45 tons of fabric feeds our            dyeing, garments, printing, AOP and embroidery divisions, enabling a fully integrated knit composite         manufacturing service.</p>\n                                        </div>\n                                    </div>                                </div>\n                            </div>\n                        </div>";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={"Knitting Division | M.M. Knitwear Ltd."}
  ogDescription={"Inside M.M. Knitwear\\u2019s knitting division: 225 sets of machines, 80,000 sq ft and 45 tons of daily fabric capacity in Gazipur."}
  ogImage={"https://www.mmknitwear.com/upload/main-banner.jpg"}
  twitterTitle={"Knitting Division | M.M. Knitwear Ltd."}
  twitterDescription={"M.M. Knitwear's knitting division in Gazipur, Bangladesh: 225 sets of knitting machines, 80,000 sq ft of floor space and 45 tons daily fabric capacity for knitwear manufacturing."}
  jsonLd={jsonLd}
  headStyle={headStyle}
  footerScripts={footerScripts}
  active=undefined
>
  <Fragment set:html={content} />
</BaseLayout>
