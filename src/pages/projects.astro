const footerScripts = "";
const content = "<div class=\"gdlr-core-pbf-wrapper \" style=\"margin: 100px 0px 0px 0px;padding: 225px 0px 205px 0px;\">\n                        <div class=\"gdlr-core-pbf-background-wrap\">\n                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/hp1-service-bg-main-ofc1.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                        </div>\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \" data-gdlr-animation=\"fadeInUp\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-element\">\n                                    <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-bottom gdlr-core-item-pdlr\">\n                                        <div class=\"gdlr-core-title-item-title-wrap \">\n                                            <h1 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"font-size: 79px;letter-spacing: 0px;text-transform: none;\">Our Projects<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h1>\n                                        </div><span class=\"gdlr-core-title-item-caption gdlr-core-info-font gdlr-core-skin-caption\" style=\"font-size: 21px;color: #999999;\">These are our in-house facilities and more are coming soon.</span></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #ffffff ;\"></div>\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-left\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-garments.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 140px 0px 70px 70px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInRight\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">GARMENTS DIVISION<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>We have a large garments unit which has 116 production lines having 3,850 sets of sewing machinery. Our independent quality team of 454 people is working to ensure the customer's required quality standard. Factory regular AQL system is 2.5 but in certain cases it depends on customer requirement. Our production capacity is 200,000 pieces per day.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 140px 70px 70px 0px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">KNITTING DIVISION<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>We have a large circular knitting unit having 225 sets of machines with 20GG, 24GG, 28GG cylinders and optimum attachments to produce all types of weft knitted fabric. Machines are Fukuhara, Fukuhama and Jiunn Long branded. We also have 28 machines with open width take down and 05 engineering striper machines. Our daily knitting capacity is 45 tons per day with a collar capacity of 25,000 pieces per day. We produce single jersey, rib (1x1, 2x2, 2x1), variegated rib (4x2, 5x3, 8x3) at solid and yarn dyed stripe (feeder / engineering / jacquard) and various design jersey.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-knitting.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #ffffff ;\"></div>\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-left\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-dyeing.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 140px 0px 70px 70px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInRight\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">DYEING DIVISION<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>Our large dyeing division is equipped with the latest state-of-the-art dyeing machinery with an in-house lab and all physical testing facilities to ensure quality parameters. Our daily dyeing capacity is 45 tons per day with 75 sets of dyeing machines and 20 sets of sample dyeing machines. We can dye cotton, viscose, modal, cotton/poly, poly/cotton and cotton/viscose. Our Biological ETP capacity is 280 m3 per hour.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\t\t\t\t\t<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 140px 70px 70px 0px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">SAMPLE &amp; CAD FACILITY<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>Our sample section is enriched with the latest machinery, expert operators and a CAD system to achieve precise markers. We offer the finest prototyping solution with 147 sets of sample machines, 8 sets of CAD machines and a monthly capacity of 14,000 pieces.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-sampling.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\t\t\t\t\t<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #ffffff ;\"></div>\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-left\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-cutting.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 140px 0px 70px 70px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInRight\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">CUTTING FACILITY<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>Our cutting facility is equipped with auto relaxation, auto spreading and auto cutting. We have 20 manual cutting tables and 8 auto cutters. We check 100% of cut panels (Kuris) before sewing input to ensure accuracy. Our daily cutting capacity is 240,000 pieces.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\t\t\t\t\t<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 140px 70px 70px 0px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h2 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"letter-spacing: 0px;text-transform: none;\">PLACEMENT PRINTING FACILITY<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h2>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 17px;\">\n                                                        <p>Our placement printing facility is equipped with both manual and machine facilities. We can handle all kinds of water base and plastisol print at pigment. Our daily placement printing capacity is 180,000 pieces with 5 auto print machines (up to 12 colours) and 20 sets of manual print, supported by a graphic design and colour team.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-printing.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\t\t\t\t\t<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 0px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #ffffff ;\"></div>\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-30 gdlr-core-column-first gdlr-core-hide-in-mobile\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-left\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-background-wrap\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/projects-embroidery.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n         