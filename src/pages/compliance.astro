];
const footerScripts = "";
const content = "<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 115px 0px 0px 0px;\">\n                        <div class=\"gdlr-core-pbf-wrapper-content gdlr-core-js \">\n                            <div class=\"gdlr-core-pbf-wrapper-container clearfix gdlr-core-container\">\n                                \n\t\t\t\t\t\t\t\t<div class=\"gdlr-core-pbf-column gdlr-core-column-45 gdlr-core-column-first\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js \" style=\"padding: 90px 80px 80px 0px;\" data-sync-height=\"height-1\" data-sync-height-center=\"\">\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\">\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-title-item gdlr-core-item-pdb clearfix  gdlr-core-left-align gdlr-core-title-item-caption-top gdlr-core-item-pdlr\" style=\"padding-bottom: 35px;\">\n                                                    <div class=\"gdlr-core-title-item-title-wrap \">\n                                                        <h1 class=\"gdlr-core-title-item-title gdlr-core-skin-title \" style=\"font-size: 36px;letter-spacing: 0px;text-transform: none;\">Compliance & Sustainability<span class=\"gdlr-core-title-item-title-divider gdlr-core-skin-divider\"></span></h1></div>\n                                                </div>\n                                            </div>\n                                            <div class=\"gdlr-core-pbf-element\">\n                                                <div class=\"gdlr-core-text-box-item gdlr-core-item-pdlr gdlr-core-item-pdb gdlr-core-left-align\" style=\"padding-bottom: 0px;\">\n                                                    <div class=\"gdlr-core-text-box-item-content\" style=\"font-size: 15px;\">\n                                                        <p>M.M. Knitwear Ltd. is committed to ethical manufacturing, sustainability and social responsibility across every stage of our vertically integrated knit composite operation in Gazipur, Bangladesh. From worker welfare and fire safety to environmental protection and certified quality management, we hold ourselves to the highest international standards.</p>\n                                                    </div>\n                                                </div>\n                                            </div>\n\t\t\t\t\t\t\t\t\t\t\t\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                <div class=\"gdlr-core-pbf-column gdlr-core-column-15\">\n                                    <div class=\"gdlr-core-pbf-column-content-margin gdlr-core-js  gdlr-core-column-extend-right\" style=\"padding: 60px 0px 60px 70px;\" data-sync-height=\"height-1\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"gdlr-core-pbf-background-wrap\" style=\"background-color: #f1f0f0 ;\">\n                                            <div class=\"gdlr-core-pbf-background gdlr-core-parallax gdlr-core-js\" style=\"background-image: url(/upload/mm-factory-1281.jpg);background-size: cover;background-position: center;\" data-parallax-speed=\"0.2\"></div>\n                                        </div>\n                                        <div class=\"gdlr-core-pbf-column-content clearfix gdlr-core-js  gdlr-core-sync-height-content\" data-gdlr-animation=\"fadeInLeft\" data-gdlr-animation-duration=\"600ms\" data-gdlr-animation-offset=\"0.8\"></div>\n                                        \n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\t\t\t\t\t<div class=\"gdlr-core-pbf-wrapper \" style=\"padding: 100px