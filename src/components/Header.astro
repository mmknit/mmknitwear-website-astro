---
import MobileNav from './react/MobileNav';
import { socials } from '../data/site';

const base = import.meta.env.BASE_URL;

interface NavItem {
  key: string;
  label: string;
  href: string;
}

const NAV: NavItem[] = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'about', label: 'About Us', href: '/about-us/' },
  { key: 'compliance', label: 'Compliance', href: '/compliance/' },
  { key: 'projects', label: 'Projects', href: '/projects/' },
  { key: 'portfolio', label: 'Portfolio', href: '/portfolio/' },
  { key: 'news', label: 'In the News', href: '/newspaper/' },
];

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <div class="topbar__links">
        <a href="mailto:info@mmknitwear.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          info@mmknitwear.com
        </a>
        <a href="tel:+8809666768768">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2Z"/></svg>
          +880 9666 768 768
        </a>
      </div>
      <div class="topbar__right">
        <span>Uttara, Dhaka &middot; Konabari, Gazipur</span>
        {socials.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="site-header__main">
    <div class="container site-header__inner">
      <a class="logo" href={base} aria-label="M.M. Knitwear Ltd. — Home">
        <img src={base + 'images/logo.png'} alt="M.M. Knitwear Ltd." width="42" height="42" />
        <span>
          M.M. Knitwear Ltd.
          <span class="logo__sub">Knit Composite Manufacturer</span>
        </span>
      </a>

      <nav class="main-nav" aria-label="Primary">
        {NAV.map((item) => (
          <a
            href={base + item.href.slice(1)}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a href={base + 'contact/'} aria-current={active === 'contact' ? 'page' : undefined}>Contact</a>
      </nav>

      <div class="header-cta">
        <a class="btn btn--primary btn--sm" href={base + 'contact/'}>Get a Quote</a>
        <MobileNav nav={NAV} active={active} client:idle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header__main {
    background: #fff;
  }

  .topbar {
    background: var(--brand-900);
    color: #aebfd8;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 40px;
    padding-block: 0.35rem;
  }

  .topbar__links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .topbar__links a,
  .topbar__right a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color 0.2s ease;
  }

  .topbar__links a:hover,
  .topbar__right a:hover {
    color: #fff;
  }

  .topbar__links svg {
    width: 15px;
    height: 15px;
  }

  .topbar__right {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .topbar__right svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  @media (max-width: 760px) {
    .topbar__right span,
    .topbar__links a:first-child {
      display: none;
    }
  }
</style>
